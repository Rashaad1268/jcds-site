---
const pathname = Astro.url.pathname;

const navItems = [
	{ href: "/#musubi", label: "MUSUBI" },
	{ href: "/#competitions", label: "Competitions" },
	{ href: "/#timeline", label: "Timeline" },
	{ href: "/#club", label: "Club" },
	{ href: "/blog", label: "Blog" },
] as const;

const isActive = (href: string) => {
	if (href === "/blog") return pathname.startsWith("/blog");
	if (href === "/#competitions") return pathname.startsWith("/competitions");
	return false;
};
---

<header class="site-header" data-site-header>
	<div class="site-container header-inner">
		<a
			class="brand focus-gold"
			href="/"
			aria-label="Japanese Club of D. S. Senanayake College, home"
		>
			<img
				class="brand-mark"
				src="/assets/brand/club-logo-light.png"
				width="1000"
				height="901"
				alt=""
				aria-hidden="true"
			/>
			<span class="brand-copy">
				<strong>MUSUBI</strong>
				<small>Japanese Club · D. S. Senanayake College</small>
			</span>
		</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a
								class:list={["nav-link", { active: isActive(item.href) }]}
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="registration-link focus-gold" href="/#registration">Registration</a>
		</nav>

		<details class="mobile-menu">
			<summary aria-label="Open navigation menu">
				<span class="menu-label">Menu</span>
				<span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
			</summary>
			<nav aria-label="Mobile navigation">
				<ul>
					{
						navItems.map((item) => (
							<li>
								<a
									class:list={["mobile-link", { active: isActive(item.href) }]}
									href={item.href}
									aria-current={isActive(item.href) ? "page" : undefined}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<a class="mobile-registration focus-gold" href="/#registration">Registration</a>
			</nav>
		</details>
	</div>
</header>

<script>
	const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => menu.removeAttribute("open"));
	});
</script>

<style>
	.site-header {
		position: sticky;
		z-index: 50;
		top: 0;
		border-bottom: 1px solid rgb(246 241 232 / 0.08);
		background: rgb(15 13 11 / 0.88);
		backdrop-filter: blur(18px);
	}

	.header-inner {
		display: flex;
		min-height: 5rem;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
	}

	.brand-mark {
		display: block;
		width: 2.65rem;
		height: 2.65rem;
		aspect-ratio: 1;
		object-fit: contain;
	}

	.brand-copy {
		display: grid;
		line-height: 1.1;
	}

	.brand-copy strong {
		color: var(--color-gold-300);
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.brand-copy small {
		margin-top: 0.3rem;
		color: var(--color-ivory-300);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.045em;
	}

	.desktop-nav,
	.desktop-nav ul {
		display: flex;
		align-items: center;
	}

	.desktop-nav {
		gap: 1.5rem;
	}

	.desktop-nav ul {
		gap: clamp(0.8rem, 1.7vw, 1.5rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-link {
		position: relative;
		padding-block: 0.75rem;
		color: var(--color-ivory-300);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 180ms var(--ease-ceremonial);
	}

	.nav-link::after {
		position: absolute;
		bottom: 0.35rem;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--color-gold-300);
		content: "";
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 180ms var(--ease-ceremonial);
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--color-ivory-50);
	}

	.nav-link:hover::after,
	.nav-link.active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.registration-link,
	.mobile-registration {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		padding-inline: 1.1rem;
		border: 1px solid var(--color-vermilion-500);
		border-radius: 0.5rem;
		background: var(--color-vermilion-650);
		color: var(--color-ivory-50);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background 180ms var(--ease-ceremonial),
			transform 180ms var(--ease-ceremonial);
	}

	.registration-link:hover,
	.mobile-registration:hover {
		background: var(--color-vermilion-500);
		transform: translateY(-1px);
	}

	.mobile-menu {
		display: none;
	}

	.mobile-menu summary {
		display: flex;
		min-width: 4.75rem;
		min-height: 2.75rem;
		align-items: center;
		justify-content: space-between;
		gap: 0.7rem;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--border-gold);
		border-radius: 0.5rem;
		color: var(--color-ivory-50);
		cursor: pointer;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		list-style: none;
		text-transform: uppercase;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.menu-icon {
		display: grid;
		width: 1rem;
		gap: 0.28rem;
	}

	.menu-icon i {
		display: block;
		height: 1px;
		background: var(--color-gold-300);
		transition: transform 180ms var(--ease-ceremonial);
	}

	.mobile-menu[open] .menu-icon i:first-child {
		transform: translateY(0.14rem) rotate(45deg);
	}

	.mobile-menu[open] .menu-icon i:last-child {
		transform: translateY(-0.14rem) rotate(-45deg);
	}

	.mobile-menu nav {
		position: absolute;
		top: calc(100% + 1px);
		left: 0;
		width: 100%;
		padding: 1rem var(--page-gutter) 1.5rem;
		border-bottom: 1px solid var(--border-gold);
		background: rgb(15 13 11 / 0.98);
		box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.35);
	}

	.mobile-menu ul {
		display: grid;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.mobile-link {
		display: block;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--border-soft);
		color: var(--color-ivory-300);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.mobile-link.active {
		color: var(--color-gold-300);
	}

	.mobile-registration {
		width: 100%;
	}

	@media (max-width: 61.999rem) {
		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			display: block;
		}
	}

	@media (max-width: 31.999rem) {
		.brand-copy small {
			display: none;
		}

		.header-inner {
			min-height: 4.5rem;
		}
	}
</style>
