---
const year = new Date().getFullYear();

const navItems = [
	{ href: "/#musubi", label: "MUSUBI 2026" },
	{ href: "/#competitions", label: "Competitions" },
	{ href: "/#club", label: "The club" },
	{ href: "/blog", label: "Blog" },
	{ href: "/credits/", label: "Image credits" },
] as const;
---

<footer class="site-footer">
	<div class="site-container footer-grid">
		<div class="footer-brand">
			<img
				class="footer-mark"
				src="/assets/brand/musubi-horizontal.png"
				width="1489"
				height="533"
				alt=""
				aria-hidden="true"
				loading="lazy"
			/>
			<p class="footer-wordmark">MUSUBI <span>2026</span></p>
			<p>The Japanese Club’s inter-school competition programme and Japanese Day for 2026.</p>
		</div>

		<nav aria-label="Footer navigation">
			<p class="footer-label">Explore</p>
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="school-block">
			<p class="footer-label">Organized by</p>
			<p><strong>Japanese Club</strong><br />D. S. Senanayake College<br />Colombo 07, Sri Lanka</p>
			<p class="footer-label">Contact</p>
			<ul>
				<li><a href="mailto:japaneseclubofdssc@gmail.com">japaneseclubofdssc@gmail.com</a></li>
				<li>
					<strong>Oneth Silva (President)</strong><br /><a href="tel:+94777434753">077 743 4753</a>
				</li>
				<li><strong>Rashaad (Editor)</strong><br /><a href="tel:+94706750230">070 675 0230</a></li>
			</ul>
		</div>
	</div>

	<div class="site-container footer-base">
		<p>© {year} Japanese Club of D. S. Senanayake College</p>
		<div>
			<a href="/rss.xml">RSS</a><span aria-hidden="true">·</span><a
				href="#top"
				aria-label="Return to the top of the page">Back to top ↑</a
			>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		padding-top: clamp(4rem, 8vw, 7rem);
		border-top: 1px solid var(--border-gold);
		background:
			radial-gradient(circle at 8% 100%, rgb(208 170 115 / 0.08), transparent 23rem),
			var(--color-ink-900);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(10rem, 0.7fr) minmax(13rem, 0.8fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		padding-bottom: clamp(3.5rem, 6vw, 5rem);
	}

	.footer-brand {
		max-width: 34rem;
		color: var(--color-ivory-300);
	}

	.footer-wordmark {
		margin: 0 0 1.25rem;
		color: var(--color-gold-300);
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 5vw, 4.25rem);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: 0.025em;
	}

	.footer-mark {
		width: min(18rem, 72%);
		height: auto;
		margin-bottom: 0.3rem;
	}

	.footer-wordmark span {
		color: var(--color-ivory-500);
		font-size: 0.55em;
		font-style: italic;
	}

	.footer-label {
		margin: 0 0 1rem;
		color: var(--color-gold-300);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.site-footer ul {
		display: grid;
		gap: 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer a {
		color: var(--color-ivory-300);
		text-decoration: none;
		transition: color 180ms var(--ease-ceremonial);
	}

	.site-footer a:hover {
		color: var(--color-gold-300);
	}

	.school-block {
		display: grid;
		align-content: start;
		gap: 0.8rem;
		color: var(--color-ivory-300);
	}

	.school-block p {
		margin: 0;
	}

	.school-block .footer-label {
		margin: 0;
	}

	.school-block ul {
		gap: 0.4rem;
	}

	.school-block strong {
		color: var(--color-ivory-50);
	}

	.footer-base {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1.4rem;
		border-top: 1px solid var(--border-soft);
		color: var(--color-ivory-500);
		font-size: 0.75rem;
	}

	.footer-base p {
		margin: 0;
	}

	.footer-base div {
		display: flex;
		gap: 0.75rem;
	}

	@media (max-width: 49.999rem) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 34.999rem) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.footer-brand {
			grid-column: auto;
		}

		.footer-base {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
