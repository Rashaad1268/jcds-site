---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<BaseLayout
	title="Stories | Japanese Club of D. S. Senanayake College"
	description="News, reflections, and cultural stories from the Japanese Club of D. S. Senanayake College."
>
	<section class="section-shell">
		<div class="site-container">
			<header class="max-w-3xl">
				<p class="eyebrow">Club journal · 部誌</p>
				<h1 class="section-title">Stories from our community</h1>
				<p class="mt-5 max-w-2xl text-pretty text-ivory-300">
					When the club begins publishing, this page will collect news, event reflections, and
					stories about learning Japanese language and culture.
				</p>
			</header>

			{
				posts.length === 0 ? (
					<div class="framed-panel mt-12 overflow-hidden p-8 sm:p-12">
						<div class="max-w-xl">
							<p class="font-japanese text-3xl text-gold-400" lang="ja">
								近日公開
							</p>
							<h2 class="mt-4 font-display text-3xl font-semibold text-ivory-50 sm:text-4xl">
								Stories coming soon
							</h2>
							<p class="mt-4 text-pretty text-ivory-300">
								There are no published articles yet. The first club story will appear here when it
								is ready.
							</p>
							<a
								href="/"
								class="mt-7 inline-flex min-h-11 items-center border border-gold-500/60 px-5 py-2.5 text-sm font-semibold text-gold-300 no-underline transition-colors hover:border-gold-300 hover:bg-gold-500/10"
							>
								Return to MUSUBI
							</a>
						</div>
					</div>
				) : (
					<div class="mt-12 grid gap-6 md:grid-cols-2">
						{posts.map((post) => (
							<article class="framed-panel group overflow-hidden">
								{post.data.cover && (
									<Image
										src={post.data.cover.image}
										alt={post.data.cover.alt}
										width={720}
										class="aspect-[16/9] w-full object-cover"
									/>
								)}
								<div class="p-6 sm:p-8">
									<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold uppercase tracking-[0.12em] text-gold-400">
										<time datetime={post.data.publishDate.toISOString()}>
											{dateFormatter.format(post.data.publishDate)}
										</time>
										{post.data.featured && <span>Featured</span>}
									</div>
									<h2 class="mt-4 font-display text-3xl font-semibold leading-tight text-ivory-50">
										<a
											href={`/blog/${post.id}/`}
											class="no-underline transition-colors group-hover:text-gold-300"
										>
											{post.data.title}
										</a>
									</h2>
									<p class="mt-3 text-pretty text-ivory-300">{post.data.description}</p>
								</div>
							</article>
						))}
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>
